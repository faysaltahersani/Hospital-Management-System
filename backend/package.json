{
  "name": "hospital-management-backend",
  "version": "1.0.0",
  "description": "Hospital Management System backend (Express + Sequelize + MySQL).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:sync": "node src/scripts/sync.js",
    "db:migrate": "node src/scripts/migrate.js up",
    "db:migrate:status": "node src/scripts/migrate.js status",
    "db:migrate:down": "node src/scripts/migrate.js down",
    "db:seed": "node src/scripts/seed.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.11.0",
    "pdfkit": "^0.19.1",
    "sequelize": "^6.37.3",
    "uuid": "^10.0.0",
    "winston": "^3.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
