# Application
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hospital_management
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql
DB_LOGGING=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE=10000

# JWT
JWT_ACCESS_SECRET=replace-with-strong-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-strong-random-string
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=hospital-management
JWT_AUDIENCE=hospital-management-client

# Security
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
